# ChargeSure Environment Variables Configuration

PROJECT_NAME="ChargeSure — Intelligent EV Charging Assurance"
TAGLINE="Always a Charge Ahead."
PORT=8000

# Security
SECRET_KEY=chargesure-super-secret-production-key-2026-ev-safe
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# For SQLite local development:
DATABASE_URL=sqlite:///./chargesure.db
# For PostgreSQL with PostGIS in production:
# DATABASE_URL=postgresql://chargesure:chargesure_pass@localhost:5432/chargesure_db

# Mode
DEMO_MODE=true

# External Services (Optional - demo fallbacks active if unconfigured)
MAPS_API_KEY=
PAYMENT_GATEWAY_KEY=
FCM_SERVER_KEY=
